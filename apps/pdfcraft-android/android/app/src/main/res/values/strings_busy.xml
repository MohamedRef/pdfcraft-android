<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The busy dialog (#614): a large file's note (%1$s is its size), the time taken so far (%1$s is 0:07), and what Cancel keeps -->
    <string name="busy_large_file">Large file (%1$s): this can take a few minutes.</string>
    <string name="busy_elapsed">%1$s so far</string>
    <string name="busy_cancel_combine">Cancel stops before the next file. Nothing is made, and your files stay as they are.</string>
    <string name="busy_cancel_export_images">Cancel stops after this page. No images are saved.</string>
    <string name="busy_cancel_save_files">Cancel stops after this file. The files already saved stay in the folder.</string>
    <!-- Compress says how far it is and can be stopped (#634): the page being read, the image being compressed, and another run when a chosen size was not reached -->
    <string name="msg_busy_compressing_reading">Compressing: reading page %1$d of %2$d…</string>
    <string name="msg_busy_compressing_images">Compressing: image %1$d of %2$d…</string>
    <string name="msg_busy_compressing_again">Compressing again to reach the size: try %1$d…</string>
    <string name="busy_cancel_compress">Cancel stops here. No file is made, and your document stays as it is.</string>
    <!-- Split and Extract pages say how far they are and can be stopped (#634): the page measured for a split by size, the part being made, Extract's three steps or the page when each page is its own file -->
    <string name="msg_busy_splitting_measuring">Splitting: measuring page %1$d of %2$d…</string>
    <string name="msg_busy_splitting_part">Splitting: part %1$d of %2$d…</string>
    <string name="msg_busy_extracting_copying">Extracting: copying the pages…</string>
    <string name="msg_busy_extracting_writing">Extracting: writing the new file…</string>
    <string name="msg_busy_extracting_checking">Extracting: checking the new file…</string>
    <string name="msg_busy_extracting_page">Extracting: page %1$d of %2$d…</string>
    <string name="busy_cancel_split">Cancel stops before the next part. No parts are kept, and your document stays as it is.</string>
    <string name="busy_cancel_extract">Cancel stops at the next step. No file is made, and your document stays as it is.</string>
</resources>
