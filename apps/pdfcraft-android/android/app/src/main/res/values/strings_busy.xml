<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The busy dialog (#614): a large file's note (%1$s is its size), the time taken so far (%1$s is 0:07), and what Cancel keeps -->
    <string name="busy_large_file">Large file (%1$s): this can take a few minutes.</string>
    <string name="busy_elapsed">%1$s so far</string>
    <string name="busy_cancel_combine">Cancel stops before the next file. Nothing is made, and your files stay as they are.</string>
    <string name="busy_cancel_export_images">Cancel stops after this page. No images are saved.</string>
    <string name="busy_cancel_save_files">Cancel stops after this file. The files already saved stay in the folder.</string>
    <!-- Compress says how far it is and can be stopped (#634): the page being read, the image being compressed, and another run when a chosen size was not reached -->
    <string name="msg_busy_compressing_reading">Compressing: reading page %1$d of %2$d…</string>
    <string name="msg_busy_compressing_images">Compressing: image %1$d of %2$d…</string>
    <string name="msg_busy_compressing_again">Compressing again to reach the size: try %1$d…</string>
    <string name="busy_cancel_compress">Cancel stops here. No file is made, and your document stays as it is.</string>
    <!-- Split and Extract pages say how far they are and can be stopped (#634): the page measured for a split by size, the part being made, Extract's three steps or the page when each page is its own file -->
    <string name="msg_busy_splitting_measuring">Splitting: measuring page %1$d of %2$d…</string>
    <string name="msg_busy_splitting_part">Splitting: part %1$d of %2$d…</string>
    <string name="msg_busy_extracting_copying">Extracting: copying the pages…</string>
    <string name="msg_busy_extracting_writing">Extracting: writing the new file…</string>
    <string name="msg_busy_extracting_checking">Extracting: checking the new file…</string>
    <string name="msg_busy_extracting_page">Extracting: page %1$d of %2$d…</string>
    <string name="busy_cancel_split">Cancel stops before the next part. No parts are kept, and your document stays as it is.</string>
    <string name="busy_cancel_extract">Cancel stops at the next step. No file is made, and your document stays as it is.</string>
    <!-- Export (Word, Excel, PowerPoint, RTF, text) says how far it is and can be stopped (#634): the page being read, then the file being written -->
    <string name="msg_busy_exporting_doc_page">Exporting: page %1$d of %2$d…</string>
    <string name="msg_busy_exporting_writing">Exporting: writing the file…</string>
    <string name="busy_cancel_export">Cancel stops after this page. No file is made, and your document stays as it is.</string>
    <!-- Print and Compare say how far they are and can be stopped (#634): Print as image's pages, the sheets laid out, the file written; Compare's pages read across both files, the comparing, the pages looked at side by side -->
    <string name="print_busy_picture">Preparing to print: page %1$d of %2$d as an image…</string>
    <string name="print_busy_sheet">Preparing to print: sheet %1$d of %2$d…</string>
    <string name="print_busy_writing">Preparing to print: writing the file…</string>
    <string name="busy_cancel_print">Cancel stops here. Nothing is printed or saved, and your document stays as it is.</string>
    <string name="compare_busy_reading">Comparing: reading page %1$d of %2$d…</string>
    <string name="compare_busy_comparing">Comparing: finding the changes…</string>
    <string name="compare_busy_visual">Comparing: looking at page %1$d of %2$d…</string>
    <string name="busy_cancel_compare">Cancel stops the comparing. Both documents stay as they are.</string>
    <!-- Combine, Create PDF and Set a password say how far they are and can be stopped (#634): the files read and opened, the pages copied, the new file written; Set a password's three steps -->
    <string name="msg_busy_combining_reading">Combining: reading file %1$d of %2$d…</string>
    <string name="msg_busy_combining_opening">Combining: opening file %1$d of %2$d…</string>
    <string name="msg_busy_combining_pages">Combining: copying the pages…</string>
    <string name="msg_busy_combining_writing">Combining: writing the new file…</string>
    <string name="msg_busy_creating_file">Creating PDF: file %1$d of %2$d…</string>
    <string name="busy_cancel_combine_step">Cancel stops at the next step. Nothing is made, and your files stay as they are.</string>
    <string name="msg_busy_protect_opening">Setting password: opening a copy…</string>
    <string name="msg_busy_protect_protecting">Setting password: protecting the copy…</string>
    <string name="msg_busy_protect_saving">Setting password: saving the protected copy…</string>
    <string name="busy_cancel_protect">Cancel stops before the next step, and while the protected copy is saved. No file is made, and your document stays as it is.</string>
    <string name="scan_enhance_busy_image">Enhancing scanned image %1$d of %2$d…</string>
    <string name="busy_cancel_scan_enhance">Cancel stops before the next image. Nothing on your pages changes.</string>
    <!-- Contents from headings says how far it is and can be stopped (#652): the page read for the headings -->
    <string name="text_styles_reading">Creating PDF contents: reading page %1$d of %2$d…</string>
    <string name="busy_cancel_text_styles">Cancel stops before the next page. No contents are added, and your document stays as it is.</string>
</resources>
